<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>VideoDownloader</AssemblyName>
    <RootNamespace>VideoDownloader.Launcher</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\src\VideoDownloader.UI\Assets\app.ico</ApplicationIcon>
    <Version>0.2.0-beta</Version>
    <AssemblyTitle>Video Downloader</AssemblyTitle>
    <Product>Video Downloader</Product>
    <Company>VideoDownloader</Company>
    <!-- Framework-dependent on .NET Framework 4.8 (preinstalled on Win10/11). -->
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
