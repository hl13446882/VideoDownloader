<Window x:Class="VideoDownloader.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding L.SettingsTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="620"
        Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="{Binding L.SettingsTabGeneral}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L.SettingsSavePath}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="{Binding L.SettingsMigrate}"
                                Command="{Binding MigrateDownloadsCommand}"
                                IsEnabled="{Binding MigrateEnabled}"
                                Padding="12,4" Margin="8,0,0,0"
                                MinWidth="64"
                                ToolTip="{Binding L.SettingsMigrateTip}"/>
                        <TextBox Text="{Binding SavePath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 ToolTip="{Binding SavePath}"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L.SettingsMaxConcurrent}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding ConcurrentOptions}"
                              SelectedItem="{Binding MaxConcurrent}"
                              IsEditable="False"
                              Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding L.SettingsRetry}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RetryCountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding L.SettingsFailedRetryInterval}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FailedRetryIntervalText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                             ToolTip="{Binding L.SettingsFailedRetryIntervalTip}"/>

                    <CheckBox Grid.Row="4" Grid.Column="1" Content="{Binding L.SettingsEnableLogging}"
                              IsChecked="{Binding LoggingEnabled}" Margin="0,0,0,4"
                              ToolTip="{Binding L.SettingsEnableLoggingTip}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding L.SettingsLogLevel}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LogLevel}" Margin="0,0,0,8"
                             IsEnabled="{Binding LoggingEnabled}"
                             ToolTip="Debug / Information / Warning / Error"/>

                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{Binding L.SettingsOpenLogsFolder}"
                                Command="{Binding OpenLogsFolderCommand}"
                                Padding="12,4" Margin="0,0,8,0"
                                ToolTip="{Binding L.SettingsOpenLogsFolderTip}"/>
                        <Button Content="{Binding L.SettingsClearLogs}"
                                Command="{Binding ClearLogsCommand}"
                                Padding="12,4"
                                ToolTip="{Binding L.SettingsClearLogsTip}"/>
                    </StackPanel>

                    <CheckBox Grid.Row="7" Grid.Column="1" Content="{Binding L.SettingsAutoRecover}"
                              IsChecked="{Binding AutoRecover}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <Button Content="{Binding L.SettingsCheckUpdate}"
                                Command="{Binding CheckUpdateCommand}"
                                Padding="12,4" Margin="0,0,12,0"
                                IsEnabled="{Binding CheckUpdateEnabled}"/>
                        <CheckBox Content="{Binding L.SettingsAutoCheckUpdates}"
                                  IsChecked="{Binding AutoCheckForUpdates}"
                                  VerticalAlignment="Center"
                                  ToolTip="{Binding L.SettingsAutoCheckUpdatesTip}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding L.SettingsAppVersion}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding AppVersionText}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding L.SettingsCopyright}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="刘志东" VerticalAlignment="Center" Margin="0,0,0,8"/>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding L.SettingsTabSubtitles}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <Grid>
                        <Grid.Resources>
                            <DataTemplate x:Key="NamedValueItem">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="168"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L.SettingsSubtitleToggle}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <CheckBox Content="{Binding L.SettingsSubtitleEnabled}"
                                      IsChecked="{Binding SubtitleEnabled}"/>
                            <TextBlock Text="{Binding L.SettingsSubtitleEnabledHint}"
                                       Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L.SettingsSubtitleMode}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding SubtitleModeOptions}"
                                  SelectedValue="{Binding SubtitleMode}"
                                  ItemTemplate="{StaticResource NamedValueItem}"
                                  SelectedValuePath="Value"
                                  Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding L.SettingsSubtitleEngine}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                            <ComboBox ItemsSource="{Binding SubtitleTranslationProviderOptions}"
                                      SelectedValue="{Binding SubtitleTranslationProvider}"
                                      ItemTemplate="{StaticResource NamedValueItem}"
                                      SelectedValuePath="Value"/>
                            <TextBlock Text="{Binding L.SettingsSubtitleCloudHint}"
                                       Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,12"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding L.SettingsSubtitleStyle}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding L.SettingsSubtitleFont}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <ComboBox Grid.Row="5" Grid.Column="1"
                                  ItemsSource="{Binding SystemFontFamilies}"
                                  SelectedValue="{Binding SubtitleFontFamily}"
                                  SelectedValuePath="FamilyName"
                                  DisplayMemberPath="DisplayName"
                                  IsEditable="False"
                                  Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding L.SettingsSubtitleSize}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding L.SettingsSubtitleSizeRange}" VerticalAlignment="Center" Foreground="#777" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding SubtitleFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding L.SettingsSubtitleColor}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <ComboBox Grid.Row="7" Grid.Column="1"
                                  ItemsSource="{Binding SubtitleColorOptions}"
                                  SelectedValue="{Binding SubtitleTextColor}"
                                  ItemTemplate="{StaticResource NamedValueItem}"
                                  SelectedValuePath="Value"
                                  Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding L.SettingsSubtitleBottom}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,10">
                            <ComboBox ItemsSource="{Binding SubtitleBottomOffsetOptions}"
                                      SelectedItem="{Binding SubtitleBottomOffsetPx}"/>
                            <TextBlock Text="{Binding L.SettingsSubtitleBottomHint}"
                                       Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Separator Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,12"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding L.SettingsSubtitleLocalEndpoint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="10" Grid.Column="1"
                                 Text="{Binding SubtitleLocalTranslationEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding SubtitleLocalTranslationFieldsEnabled}"
                                 Margin="0,0,0,8"
                                 ToolTip="{Binding L.SettingsSubtitleLocalEndpointTip}"/>

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="{Binding L.SettingsSubtitleLocalModel}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="11" Grid.Column="1"
                                 Text="{Binding SubtitleLocalTranslationModel, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding SubtitleLocalTranslationFieldsEnabled}"
                                 Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="{Binding L.SettingsSubtitleWhisper}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,4,8,8"/>
                        <StackPanel Grid.Row="12" Grid.Column="1" Margin="0,0,0,8">
                            <TextBox Text="{Binding SubtitleWhisperModelPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{Binding L.SettingsSubtitleInstallBase}"
                                        Command="{Binding InstallWhisperModelCommand}"
                                        IsEnabled="{Binding SubtitleModelInstallEnabled}"
                                        MinWidth="140" Padding="8,4"/>
                                <TextBlock Text="{Binding L.SettingsSubtitleInstallHint}"
                                           Foreground="#777" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SubtitleModelInstallStatus}" Foreground="#777" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}" Foreground="#047857" Margin="0,10,0,8" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding L.SettingsSave}" Command="{Binding SaveCommand}" Width="80" Height="32" Margin="0,0,8,0"/>
            <Button Content="{Binding L.SettingsClose}" Width="80" Height="32" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
