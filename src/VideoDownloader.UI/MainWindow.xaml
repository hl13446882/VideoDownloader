<Window x:Class="VideoDownloader.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VideoDownloader.UI.ViewModels"
        xmlns:conv="clr-namespace:VideoDownloader.UI.Converters"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseLeftButtonDown"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Title="Video Downloader"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="900"
        Width="1280"
        MinHeight="700"
        MinWidth="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullableDoubleToWidthConverter x:Key="TabWidthConv"/>
        <conv:TabMaxWidthConverter x:Key="TabMaxWidthConv"/>
        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Content" Value="×"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <!-- Hover on the tab row -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </DataTrigger>
                <!-- Selected tab always shows close (touch / no-hover) -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabSpeakerStyle" TargetType="Border">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#38BDF8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudiblePlaying}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="TabSpeakerBlink">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.35" To="1" Duration="0:0:0.55"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="TabSpeakerBlink"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="{Binding WindowContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Address | Status | New | Favorite | Local | Back | Forward | Lang | Probe | Auto | Settings -->
        <Grid Grid.Row="0" Margin="0,0,0,6"
              Visibility="{Binding IsAppChromeVisible, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="AddressBox"
                      Grid.Column="0"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      StaysOpenOnEdit="False"
                      Text="{Binding AddressBar, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      ItemsSource="{Binding AddressPresets}"
                      ToolTip="{Binding L.TipAddressBar}"
                      MinWidth="160"
                      Height="32"
                      VerticalContentAlignment="Center"
                      Padding="4,2"
                      Margin="0,0,8,0"
                      PreviewKeyDown="AddressBox_PreviewKeyDown"
                      SelectionChanged="AddressBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="72"/>
                            <TextBlock Text="{Binding Url}" Foreground="#666666" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       ToolTip="{Binding StatusMessage}"
                       Foreground="#B45309"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,8,0"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"/>
            <Button Grid.Column="2"
                    Content="{Binding L.NavNewTab}"
                    ToolTip="{Binding L.TipNewTab}"
                    Command="{Binding AddTabCommand}"
                    Width="72" Height="32" Margin="0,0,4,0"/>
            <Button Grid.Column="3"
                    Content="{Binding L.NavFavorite}"
                    ToolTip="{Binding L.TipFavorite}"
                    Command="{Binding FavoriteAddressCommand}"
                    Width="56" Height="32" Margin="0,0,4,0"/>
            <Button Grid.Column="4"
                    Content="{Binding L.NavLocal}"
                    ToolTip="{Binding L.TipLocal}"
                    Command="{Binding GoLocalLibraryCommand}"
                    Width="56" Height="32" Margin="0,0,4,0"/>
            <Button Grid.Column="5"
                    Content="{Binding L.NavBack}"
                    ToolTip="{Binding L.TipBack}"
                    Command="{Binding GoBackCommand}"
                    Width="56" Height="32" Margin="0,0,4,0"/>
            <Button Grid.Column="6"
                    Content="{Binding L.NavForward}"
                    ToolTip="{Binding L.TipForward}"
                    Command="{Binding GoForwardCommand}"
                    Width="56" Height="32" Margin="0,0,4,0"/>
            <Button Grid.Column="7"
                    Content="{Binding L.LanguageToggleLabel}"
                    ToolTip="{Binding L.LanguageToggleTip}"
                    Command="{Binding ToggleLanguageCommand}"
                    Width="40" Height="32" Margin="0,0,4,0"/>
            <Button Grid.Column="8"
                    Content="{Binding L.NavProbe}"
                    ToolTip="{Binding L.TipProbe}"
                    Command="{Binding RefreshCommand}"
                    Width="72" Height="32" Margin="0,0,4,0"/>
            <Button Grid.Column="9"
                    Content="{Binding AutoModeButtonLabel}"
                    ToolTip="{Binding L.TipAuto}"
                    Command="{Binding ToggleAutoModeCommand}"
                    Width="72" Height="32" Margin="0,0,4,0"/>
            <Button Grid.Column="10"
                    Content="{Binding L.NavSettings}"
                    ToolTip="{Binding L.TipSettings}"
                    Command="{Binding OpenSettingsCommand}"
                    Width="72" Height="32"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="BrowserPane"
                       Grid.Column="0"
                       Margin="{Binding BrowserPaneMargin}"
                       SizeChanged="BrowserPane_SizeChanged">
                <ListBox x:Name="TabStrip"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                         DockPanel.Dock="Top"
                         Height="34"
                         AlternationCount="9999"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Margin="0,0,0,4"
                         Visibility="{Binding IsAppChromeVisible, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Width" Value="{Binding FixedWidth, Converter={StaticResource TabWidthConv}}"/>
                            <Setter Property="MaxWidth" Value="{Binding FixedWidth, Converter={StaticResource TabMaxWidthConv}}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TabChrome"
                                                Background="#D0D4DA"
                                                BorderThickness="0"
                                                SnapsToDevicePixels="True">
                                            <DockPanel LastChildFill="True">
                                                <Rectangle x:Name="TabSep"
                                                           DockPanel.Dock="Left"
                                                           Width="1"
                                                           Height="16"
                                                           Margin="0,0,0,0"
                                                           Fill="#9AA0A8"
                                                           VerticalAlignment="Center"/>
                                                <ContentPresenter Margin="10,4,6,4"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Stretch"
                                                                  RecognizesAccessKey="True"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabChrome" Property="Background" Value="#A8AEB8"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="TabChrome" Property="Background" Value="#B8BEC6"/>
                                            </MultiTrigger>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                <Setter TargetName="TabSep" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource TabSpeakerStyle}">
                                    <TextBlock Text="🔊"
                                               FontSize="8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-1,0,0"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding Title}"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource TabCloseButtonStyle}"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border BorderBrush="#CCC" CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAppFullscreen}" Value="True">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CornerRadius" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid x:Name="WebViewHostPanel"/>
                </Border>
            </DockPanel>

            <Grid Grid.Column="1"
                  Width="300"
                  Visibility="{Binding IsSidePanelVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="{Binding L.SideDetected}" Margin="0,0,0,4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <ComboBox ItemsSource="{Binding SelectedDetectedVideo.ModeOptions}"
                                      SelectedItem="{Binding SelectedDetectedVideo.SelectedMode, Mode=TwoWay}"
                                      Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SelectedDetectedVideo.Variants}"
                                      SelectedItem="{Binding SelectedDetectedVideo.SelectedVariant, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Margin="0,0,0,4"/>
                            <Button Content="{Binding L.BtnDownload}"
                                    Height="28"
                                    Command="{Binding DownloadSelectedVideoCommand}"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding DetectedVideos}"
                                 SelectedItem="{Binding SelectedDetectedVideo, Mode=TwoWay}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="#B45309"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="{Binding L.SideQueue}" Margin="0,4,0,4">
                    <ListBox x:Name="DownloadQueueList"
                             ItemsSource="{Binding QueueRows}"
                             SelectionMode="Extended"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ToolTip="{Binding L.QueueTooltip}"
                             SelectionChanged="OnDownloadQueueSelectionChanged"
                             MouseDoubleClick="OnDownloadQueueDoubleClick"
                             PreviewMouseLeftButtonDown="OnDownloadQueuePreviewMouseLeftButtonDown"
                             PreviewMouseRightButtonDown="OnDownloadQueuePreviewMouseRightButtonDown"
                             PreviewKeyDown="OnDownloadQueuePreviewKeyDown"
                             ContextMenuOpening="OnDownloadQueueContextMenuOpening">
                        <ListBox.InputBindings>
                            <KeyBinding Key="F2" Command="{Binding BeginRenameSelectedCommand}"/>
                            <KeyBinding Key="Delete" Command="{Binding DeleteSelectedQueueCommand}"/>
                            <KeyBinding Key="Return" Command="{Binding PlaySelectedDownloadCommand}"/>
                        </ListBox.InputBindings>
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type vm:QueueGroupViewModel}">
                                <DockPanel Margin="0,4,0,2" Background="Transparent">
                                    <TextBlock Text="{Binding Glyph}"
                                               Width="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding CountText}"
                                               Margin="8,0,0,0"
                                               Foreground="#888"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Domain}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:DownloadJobViewModel}">
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Margin" Value="0,2,0,2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGrouped}" Value="True">
                                                    <Setter Property="Margin" Value="16,2,0,2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   ToolTip="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Foreground" Value="#222222"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="#123A8C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <DockPanel>
                                            <DockPanel.Style>
                                                <Style TargetType="DockPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DockPanel.Style>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding ExtensionLabel}"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#888"/>
                                            <TextBox Text="{Binding EditStem, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="2,1"
                                                     Loaded="OnRenameTextBoxLoaded"
                                                     LostFocus="OnRenameTextBoxLostFocus"
                                                     PreviewKeyDown="OnRenameTextBoxPreviewKeyDown"/>
                                        </DockPanel>
                                    </Grid>
                                    <ProgressBar Height="3"
                                                 Margin="0,3,0,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#555">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Status}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#666666"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFileMissing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Foreground" Value="#123A8C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.Resources>
                        <ListBox.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Opened="OnDownloadQueueContextMenuOpened">
                                <MenuItem Header="{Binding L.MenuPlay}"
                                          Command="{Binding PlaySelectedDownloadCommand}"/>
                                <MenuItem Header="{Binding L.MenuRename}"
                                          Command="{Binding BeginRenameSelectedCommand}"/>
                                <MenuItem Header="{Binding L.MenuOpenFolder}"
                                          Command="{Binding OpenSelectedFolderCommand}"/>
                                <MenuItem Header="{Binding L.MenuOpenUrl}"
                                          Command="{Binding OpenSelectedPageCommand}"/>
                                <Separator/>
                                <MenuItem Header="{Binding L.MenuPause}"
                                          Command="{Binding PauseSelectedCommand}"/>
                                <MenuItem Header="{Binding L.MenuResume}"
                                          Command="{Binding ResumeSelectedCommand}"/>
                                <MenuItem Header="{Binding L.MenuCancel}"
                                          Command="{Binding CancelSelectedCommand}"/>
                                <Separator/>
                                <MenuItem Header="{Binding L.MenuRemove}"
                                          Command="{Binding RemoveSelectedCommand}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </GroupBox>

                <StackPanel x:Name="QueueActionBar" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{Binding QueueGroupToggleLabel}" Width="56" Height="28" Margin="0,0,4,0" Command="{Binding ToggleQueueGroupingCommand}"/>
                    <Button Content="{Binding L.BtnPause}" Width="56" Height="28" Margin="0,0,4,0" Command="{Binding PauseSelectedCommand}"/>
                    <Button Content="{Binding L.BtnResume}" Width="56" Height="28" Margin="0,0,4,0" Command="{Binding ResumeSelectedCommand}"/>
                    <Button Content="{Binding L.BtnCancel}" Width="56" Height="28" Margin="0,0,4,0" Command="{Binding CancelSelectedCommand}"/>
                    <Button Content="{Binding L.BtnRemove}" Width="56" Height="28" Command="{Binding RemoveSelectedCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
