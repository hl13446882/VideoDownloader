<Window x:Class="VideoDownloader.UI.SubtitleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sub="clr-namespace:VideoDownloader.Core.Subtitles;assembly=VideoDownloader.Core"
        Title="智能字幕设置 / Subtitle Settings"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="760" Width="620"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存 / Save" Command="{Binding SaveCommand}" Width="96" Height="32" Margin="0,0,8,0"/>
            <Button Content="关闭 / Close" Width="96" Height="32" IsCancel="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="1" Content="启用智能字幕 / Enable subtitles"
                          IsChecked="{Binding SubtitleEnabled}" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="字幕模式 / Mode" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding SubtitleMode, Mode=TwoWay}"
                          SelectedValuePath="Tag" Margin="0,0,0,8">
                    <ComboBoxItem Content="原文 / Original" Tag="{x:Static sub:SubtitleMode.Original}"/>
                    <ComboBoxItem Content="中文 / Chinese" Tag="{x:Static sub:SubtitleMode.Chinese}"/>
                    <ComboBoxItem Content="英语 / English" Tag="{x:Static sub:SubtitleMode.English}"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="提前处理 / Preload" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right" Text=" 秒 / sec" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SubtitlePreloadAheadSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,12"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Whisper 模型" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SubtitleWhisperModelPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="翻译引擎 / Translator" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="本地翻译 / Local (默认)" FontWeight="SemiBold"/>
                    <TextBlock Text="云翻译 / Cloud：接口已预留，本版本未启用" Foreground="#777" FontSize="11"/>
                </StackPanel>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="本地翻译地址" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SubtitleLocalTranslationEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                         ToolTip="仅允许 127.0.0.1 / localhost 的 OpenAI-compatible chat/completions 地址"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="本地翻译模型" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SubtitleLocalTranslationModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                <Separator Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,12"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="字体 / Font" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding SubtitleFontFamily, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="字号 / Size" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Width="80" Text="{Binding SubtitleFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="粗体 / Bold" IsChecked="{Binding SubtitleBold}" Margin="16,2,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="文字颜色 / Text" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding SubtitleTextColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="#RRGGBB"/>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="描边 / Outline" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Width="130" Text="{Binding SubtitleOutlineColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="#RRGGBB"/>
                    <TextBlock Text=" 宽度 " VerticalAlignment="Center"/>
                    <TextBox Width="60" Text="{Binding SubtitleOutlineSize, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <TextBlock Grid.Row="13" Grid.Column="0" Text="背景 / Background" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Width="130" Text="{Binding SubtitleBackgroundColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="#RRGGBB"/>
                    <TextBlock Text=" 透明度 " VerticalAlignment="Center"/>
                    <TextBox Width="70" Text="{Binding SubtitleBackgroundOpacity, UpdateSourceTrigger=PropertyChanged}" ToolTip="0.0 - 1.0"/>
                </StackPanel>

                <TextBlock Grid.Row="14" Grid.Column="0" Text="距底部 / Bottom" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <DockPanel Grid.Row="14" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right" Text=" px" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SubtitleBottomOffsetPx, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <TextBlock Grid.Row="15" Grid.Column="0" Text="最大行数 / Max lines" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="15" Grid.Column="1" Text="{Binding SubtitleMaxLines, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="16" Grid.Column="0" Text="最大宽度 / Max width" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <DockPanel Grid.Row="16" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right" Text=" %" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SubtitleMaxWidthPercent, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <TextBlock Grid.Row="17" Grid.Column="0" Text="字幕偏移 / Offset" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DockPanel Grid.Row="17" Grid.Column="1">
                    <TextBlock DockPanel.Dock="Right" Text=" ms（正值=延后显示）" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SubtitleOffsetMs, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
