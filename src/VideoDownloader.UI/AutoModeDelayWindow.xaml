<Window x:Class="VideoDownloader.UI.AutoModeDelayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TitleText}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding PromptText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox Grid.Row="1"
                 x:Name="MinutesBox"
                 Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}"
                 Height="28"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,8"/>
        <TextBlock Grid.Row="2"
                   Text="{Binding HintText}"
                   TextWrapping="Wrap"
                   Foreground="#666"
                   Margin="0,0,0,8"/>
        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorText}"
                   Foreground="#B91C1C"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   MinHeight="18"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding CancelText}" Width="80" Height="28" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
            <Button Content="{Binding OkText}" Width="80" Height="28" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
